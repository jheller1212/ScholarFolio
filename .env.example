# ScholarFolio — client environment (Vite).
# Everything here is bundled into the browser build, so it must be safe to
# publish: the Supabase URL and the PUBLISHABLE (anon) key only. Real secrets
# — the Supabase service-role key, Stripe secret key, OpenAlex key — live in
# the edge functions' server-side env and must never appear here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
